# Your GitHub Personal Access Token (PAT)
# Classic PAT needs `user:follow` scope
# Fine-grained PAT needs `Followers` Read & Write access
GITHUB_TOKEN=your_github_personal_access_token_here

# Default Target User to extract followers from (optional)
# GITHUB_TARGET_USER=ragibalasad

# Max follows per run (optional, default: 50)
# MAX_FOLLOWS=50

# Minimum and Maximum delay in seconds between follow requests (optional, default: 2.0 and 4.0)
# DELAY_MIN=2.0
# DELAY_MAX=4.0
